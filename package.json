{
  "name": "dentiva",
  "version": "1.0.0",
  "description": "Dentiva — premium local-first dental clinic management for Windows.",
  "main": "electron/main.cjs",
  "author": "Md. Shohan Khan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "preview": "node scripts/preview-server.cjs",
    "build:web": "node scripts/prepare-release.cjs",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "test": "node --test tests/*.test.cjs",
    "lint": "node --check src/app.js && node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "electron-log": "^5.4.2"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dentiva.clinic",
    "productName": "Dentiva",
    "artifactName": "Dentiva-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!tests/**/*",
      "!scripts/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/dentiva.ico",
      "artifactName": "Dentiva-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Dentiva-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dentiva",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["en_US"]
    },
    "linux": { "target": ["dir"] }
  }
}
